{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 220
      },
      "children": [
        {
          "id": "bot",
          "type": "block",
          "size": {
            "px": 160
          },
          "window_drag": true,
          "content": {
            "mod": "sidebar-bot"
          }
        },
        {
          "id": "machines",
          "type": "block",
          "content": {
            "mod": "machine-sidebar"
          }
        }
      ]
    },
    {
      "id": "main",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "header": {
            "content": {
              "mod": "terminals-pane"
            },
            "height": 38
          },
          "background": "#17191c",
          "border": {
            "width": 1,
            "color": "#24272b"
          },
          "focus": {
            "width": 1,
            "color": "#33363b"
          },
          "radius": 12,
          "gap": 8,
          "lone": true
        }
      }
    }
  ],
  "background": "#131619",
  "padding": [
    6,
    6
  ],
  "theme": "graphite",
  "colors": {
    "accent": "#3b82f6",
    "background": "#131619",
    "border": "#25282c",
    "dim": "#8b8f95",
    "foreground": "#e8e9eb",
    "hover": "#ffffff0d",
    "muted": "#a9adb3",
    "raised": "#202225",
    "selection": "#264f78",
    "surface": "#17191c",
    "terminal_foreground": "#e6e7e9"
  },
  "font_size": 15,
  "gap": 8,
  "titlebar": "none",
  "traffic_lights": [
    16,
    18
  ]
}
